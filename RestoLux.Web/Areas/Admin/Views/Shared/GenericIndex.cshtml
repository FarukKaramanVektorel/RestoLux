@model RestoLux.Web.Models.Admin.AdminListViewModel
@{
    ViewData["Title"] = Model.Title;
}
<h2 class="mb-3">@Model.Title</h2>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni Ekle</a>
@if (!Model.Items.Any())
{
    <p>Kayıt bulunamadı.</p>
}
else
{
    var props = Model.Items.First().GetType().GetProperties();
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    @foreach (var p in props)
                    {
                        <th>@Label(p.Name)</th>
                    }
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    var idProp = item.GetType().GetProperty("Id");
                    var idVal = idProp?.GetValue(item);
                    <tr>
                        @foreach (var p in props)
                        {
                            <td>@p.GetValue(item)</td>
                        }
                        <td>
                            <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@idVal">Detay</a>
                            <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@idVal">Düzenle</a>
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@idVal">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

