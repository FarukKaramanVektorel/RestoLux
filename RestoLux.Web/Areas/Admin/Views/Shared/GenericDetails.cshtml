@model object
@{
    ViewData["Title"] = "Detay";
    var props = Model.GetType().GetProperties();
}
<h2 class="mb-3">Detay</h2>
<dl class="row">
    @foreach (var p in props)
    {
        <dt class="col-sm-3">@p.Name</dt>
        <dd class="col-sm-9">@p.GetValue(Model)</dd>
    }
</dl>
<a class="btn btn-secondary" asp-action="Index">Geri</a>