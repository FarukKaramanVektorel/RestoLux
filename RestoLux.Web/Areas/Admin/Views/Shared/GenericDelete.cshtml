@model object
@{
    ViewData["Title"] = "Sil";
    var props = Model.GetType().GetProperties();
    var id = props.FirstOrDefault(p => p.Name == "Id")?.GetValue(Model);
}
<h2 class="mb-3">Sil</h2>
<p>Bu kaydı silmek istediğinize emin misiniz?</p>
<dl class="row">
    @foreach (var p in props)
    {
        <dt class="col-sm-3">@p.Name</dt>
        <dd class="col-sm-9">@p.GetValue(Model)</dd>
    }
</dl>
<form asp-action="Delete" asp-route-id="@id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Sil</button>
    <a class="btn btn-secondary" asp-action="Index">İptal</a>
</form>