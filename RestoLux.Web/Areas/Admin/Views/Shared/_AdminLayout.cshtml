<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestoLux Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { display: flex; min-height: 100vh; }
        .sidebar { width: 240px; background: #1f2937; color: #fff; }
        .sidebar a { color: #d1d5db; text-decoration: none; display: block; padding: 10px 16px; }
        .sidebar a:hover, .sidebar a.active { background: #374151; color: #fff; }
        .content { flex: 1; padding: 24px; background: #f3f4f6; }
        @@media (max-width: 768px) {
            body { flex-direction: column; }
            .sidebar { width: 100%; height: auto; }
            .sidebar nav { display: flex; overflow-x: auto; flex-wrap: nowrap; }
            .sidebar a { white-space: nowrap; padding: 8px 12px; }
            .topbar { padding: 8px 12px; }
            .content { padding: 12px; }
            #bellLink { font-size: 1rem; }
        }
        .topbar { background: #fff; padding: 12px 24px; border-bottom: 1px solid #e5e7eb; }
    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="p-3">
            <a href="/" target="_blank">
                <img src="~/images/RestoLux.png" alt="RestoLux" height="32" />
            </a>
        </div>
        <nav>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a asp-area="Admin" asp-controller="Restaurants" asp-action="Index">Restoranlar</a>
            <a asp-area="Admin" asp-controller="Branches" asp-action="Index">Şubeler</a>
            <a asp-area="Admin" asp-controller="Menus" asp-action="Index">Menüler</a>
            <a asp-area="Admin" asp-controller="MenuCategories" asp-action="Index">Kategoriler</a>
            <a asp-area="Admin" asp-controller="Products" asp-action="Index">Ürünler</a>
            <a asp-area="Admin" asp-controller="Customers" asp-action="Index">Müşteriler</a>
            <a asp-area="Admin" asp-controller="Reservations" asp-action="Index">Rezervasyonlar</a>
            <a asp-area="Admin" asp-controller="Reviews" asp-action="Index">Yorumlar</a>
            <a asp-area="Admin" asp-controller="Allergens" asp-action="Index">Alerjenler</a>
            <a asp-area="Admin" asp-controller="DietaryTags" asp-action="Index">Diyet Etiketleri</a>
            <a asp-area="Admin" asp-controller="TaxRules" asp-action="Index">Vergi Kuralları</a>
            <a asp-area="Admin" asp-controller="DiningAreas" asp-action="Index">Yemek Alanları</a>
            <a asp-area="Admin" asp-controller="DiningTables" asp-action="Index">Masalar</a>
            <a asp-area="Admin" asp-controller="OpeningHours" asp-action="Index">Açılış Saatleri</a>
            <a asp-area="Admin" asp-controller="SpecialClosures" asp-action="Index">Özel Kapanışlar</a>
            <a asp-area="Admin" asp-controller="ContentPages" asp-action="Index">İçerik Sayfaları</a>
            <a asp-area="Admin" asp-controller="SiteSettings" asp-action="Index">Site Ayarları</a>
            <a asp-area="Admin" asp-controller="ModifierGroups" asp-action="Index">Modifier Grupları</a>
            <a asp-area="Admin" asp-controller="ProductVariants" asp-action="Index">Ürün Varyantları</a>
            <a asp-area="Admin" asp-controller="ProductImages" asp-action="Index">Ürün Görselleri</a>
            <a asp-area="Admin" asp-controller="BranchProductAvailabilities" asp-action="Index">Şube Ürün Uygunluğu</a>
            <a asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Index">Bildirim Şablonları</a>
        </nav>
    </aside>
    <div class="flex-grow-1 d-flex flex-column">
        <header class="topbar d-flex justify-content-between align-items-center">
            <span class="fw-semibold">@ViewData["Title"]</span>
            <div class="d-flex align-items-center gap-3">
                <a href="/Admin/Reservations" class="position-relative text-decoration-none" id="bellLink" title="Rezervasyonlar">
                    <span style="font-size:1.4rem;">&#128276;</span>
                    <span id="bellBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;">0</span>
                </a>
            </div>
        </header>
        <main class="content">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            let previous = 0;
            let audioCtx = null;
            function playBell() {
                try {
                    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.type = 'sine';
                    osc.frequency.value = 880;
                    gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.5);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.5);
                } catch (e) { /* ignore */ }
            }
            async function check() {
                try {
                    const res = await fetch('/Admin/Notifications/UnreadCount');
                    const data = await res.json();
                    const badge = document.getElementById('bellBadge');
                    if (data.count > 0) {
                        badge.style.display = '';
                        badge.textContent = data.count;
                    } else {
                        badge.style.display = 'none';
                    }
                    if (data.count > previous && previous !== 0) {
                        playBell();
                    }
                    previous = data.count;
                } catch (e) { /* ignore */ }
            }
            check();
            setInterval(check, 10000);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>