@model object
@{
    ViewData["Title"] = "Düzenle";
    var props = Model.GetType().GetProperties();
    var id = ViewData["Id"];
}
<h2 class="mb-3">Düzenle</h2>
<form asp-action="Edit" asp-route-id="@id" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    @foreach (var p in props)
    {
        <div class="col-md-6">
            <label class="form-label">@p.Name</label>
            @if (p.PropertyType == typeof(bool))
            {
                <input type="checkbox" name="@p.Name" value="true" class="form-check-input" @( (bool)(p.GetValue(Model) ?? false) ? "checked" : "" ) />
            }
            else if (p.PropertyType.IsEnum)
            {
                <select name="@p.Name" class="form-select">
                    @foreach (var v in Enum.GetValues(p.PropertyType))
                    {
                        <option value="@v" selected="@(Equals(p.GetValue(Model), v))">@v</option>
                    }
                </select>
            }
            else
            {
                <input name="@p.Name" value="@p.GetValue(Model)" class="form-control" />
            }
        </div>
    }
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a class="btn btn-secondary" asp-action="Index">İptal</a>
    </div>
</form>