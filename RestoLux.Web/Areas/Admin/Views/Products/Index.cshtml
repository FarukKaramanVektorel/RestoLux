@{
    ViewData["Title"] = "Ürünler";
    var products = ViewBag.Products as IEnumerable<RestoLux.Application.DTOs.ProductDto> ?? new List<RestoLux.Application.DTOs.ProductDto>();
    var images = ViewBag.ProductImages as IEnumerable<RestoLux.Application.DTOs.ProductImageDto> ?? new List<RestoLux.Application.DTOs.ProductImageDto>();
    var cats = ViewBag.Categories as IEnumerable<RestoLux.Application.DTOs.MenuCategoryDto> ?? new List<RestoLux.Application.DTOs.MenuCategoryDto>();
}
<h2 class="mb-3">Ürünler</h2>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni Ürün</a>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Görsel</th>
                <th>Ad</th>
                <th>Kategori</th>
                <th>Fiyat</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in products)
            {
                var img = images.FirstOrDefault(i => i.ProductId == p.Id);
                var cat = cats.FirstOrDefault(c => c.Id == p.CategoryId);
                <tr>
                    <td>
                        @if (img != null)
                        {
                            <img src="@img.Url" alt="@p.Name" style="width:48px;height:48px;object-fit:cover;border-radius:6px;" />
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>@p.Name</td>
                    <td>@(cat?.Name ?? p.CategoryId.ToString())</td>
                    <td>@p.Price.ToString("C")</td>
                    <td>
                        @if (p.IsActive) { <span class="badge bg-success">Aktif</span> } else { <span class="badge bg-secondary">Pasif</span> }
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@p.Id">Düzenle</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@p.Id">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>