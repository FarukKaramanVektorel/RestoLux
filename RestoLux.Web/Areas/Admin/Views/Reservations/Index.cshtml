@using RestoLux.Web.Areas.Admin.Controllers
@{
    ViewData["Title"] = "Rezervasyonlar";
    var rows = ViewBag.Rows as IEnumerable<ReservationRowDto> ?? new List<ReservationRowDto>();
}
<h2 class="mb-3">Rezervasyonlar</h2>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni Rezervasyon</a>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Müşteri</th>
                <th>Şube</th>
                <th>Tarih</th>
                <th>Saat</th>
                <th>Kişi</th>
                <th>Durum</th>
                <th>Özel İstek</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td>@r.CustomerName</td>
                    <td>@r.BranchName</td>
                    <td>@r.Date.ToString("dd.MM.yyyy")</td>
                    <td>@r.StartTime.ToString("HH:mm") - @r.EndTime.ToString("HH:mm")</td>
                    <td>@r.GuestCount</td>
                    <td>@r.Status</td>
                    <td>@r.SpecialRequests</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@r.Id">Düzenle</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@r.Id">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>